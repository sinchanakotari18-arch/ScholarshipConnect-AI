# ==============================================================
# ScholarshipConnect AI - Production & Development Configuration
# ==============================================================

# Server port (Defaults to 5000 in dev, automatically set by Render/Railway/Heroku in cloud)
PORT=5000

# MongoDB Connection String (MongoDB Atlas cloud database)
# Replace with your connection string: mongodb+srv://<username>:<password>@cluster0.mongodb.net/scholarshipconnect?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.tngt184.mongodb.net/scholarshipconnect?appName=Cluster0

# JWT Secret key for authentication tokens
JWT_SECRET=scholarshipconnect_jwt_secret_2026_secure_key

# Optional: Google Gemini API Key for ScholarBot AI live responses
# Free keys can be created at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Backend API URL for the frontend:
# - Leave blank or use "/api" for All-in-One deployment (Render / Railway / Single server)
# - Set to your deployed backend URL if hosting frontend separately on Vercel/Netlify:
#   e.g. VITE_API_URL=https://scholarshipconnect-backend.onrender.com/api
VITE_API_URL=

# Allowed Client Origin for CORS (e.g., https://your-frontend.vercel.app)
CLIENT_URL=